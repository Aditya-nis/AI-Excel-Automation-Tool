# Django Application Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app

# Database Configuration
# For Vercel or cloud (Neon, Supabase, AWS RDS):
# DATABASE_URL=postgres://user:password@host:5432/dbname
# For Local PostgreSQL:
# DB_ENGINE=postgresql
# DB_NAME=advancedexcel
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# For SQLite (default for local development if DATABASE_URL is not set):
# DB_ENGINE=sqlite3

# Celery & Redis (Required for asynchronous automation jobs)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Optional External AI Provider Credentials
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
