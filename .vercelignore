staticfiles/
media/
*.sqlite3
*.sqlite3-journal
.git/
.github/
.vscode/
.idea/
tests/
Dockerfile
docker-compose.yml
.dockerignore
*.md
!README.md
__pycache__/
*.pyc
*.pyo
